{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/clickety-clacks/agent-window-resolver/schema/window-session-v1.json",
  "title": "Agent Window Resolver window session protocol v1",
  "$defs": {
    "window": { "$ref": "v1.json#/$defs/window" },
    "limits": { "$ref": "v1.json#/$defs/limits" },
    "requestId": { "$ref": "v1.json#/$defs/requestId" },
    "machine": { "$ref": "v1.json#/$defs/machine" },
    "reason": { "$ref": "v1.json#/$defs/reason" },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "requestId", "operation", "window", "windows", "local"],
      "properties": {
        "schema": { "const": "agent-window-resolver.window-session.request.v1" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "operation": { "const": "window-session" },
        "window": { "$ref": "#/$defs/window" },
        "windows": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "#/$defs/window" } },
        "local": {
          "type": "object", "additionalProperties": false, "required": ["machine"],
          "properties": { "machine": { "$ref": "#/$defs/machine" } }
        },
        "limits": { "$ref": "#/$defs/limits" }
      }
    },
    "session": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "basis", "method"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "host": { "$ref": "#/$defs/machine" },
        "transport": { "enum": ["ssh", "mosh", "et"] },
        "basis": { "enum": ["current", "launch"] },
        "method": { "enum": ["local-client", "remote-ancestry", "remote-unique-connection", "remote-endpoint", "launch"] }
      },
      "allOf": [
        { "if": { "properties": { "basis": { "const": "launch" } } }, "then": { "properties": { "method": { "const": "launch" } } } },
        { "if": { "required": ["host"] }, "then": { "required": ["transport"] }, "else": { "not": { "required": ["transport"] } } }
      ]
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "requestId", "operation", "status", "session", "reasons"],
      "properties": {
        "schema": { "const": "agent-window-resolver.window-session.response.v1" },
        "resolverVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "requestId": { "oneOf": [{ "$ref": "#/$defs/requestId" }, { "type": "null" }] },
        "operation": { "const": "window-session" },
        "status": { "enum": ["found", "none", "unknown", "invalid"] },
        "session": { "oneOf": [{ "$ref": "#/$defs/session" }, { "type": "null" }] },
        "reasons": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/reason" } }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "found" } } }, "then": { "properties": { "session": { "$ref": "#/$defs/session" } } }, "else": { "properties": { "session": { "type": "null" } } } },
        { "if": { "properties": { "status": { "enum": ["unknown", "invalid"] } } }, "then": { "properties": { "reasons": { "minItems": 1 } } } }
      ]
    }
  }
}
