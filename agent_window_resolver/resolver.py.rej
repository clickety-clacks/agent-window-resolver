-        if any(endpoint_linked(left, right)
-               for left in transport_endpoints for right in remote_endpoints):
-            linked[_identity_key(client.process)] = client
+        for left in sorted(transport_endpoints, key=repr):
+            for right in sorted(remote_endpoints, key=repr):
+                if endpoint_linked(left, right):
+                    linked.setdefault(
+                        _identity_key(client.process), (client, left, right),
+                    )
     return tuple(linked.values())
